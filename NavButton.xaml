<UserControl x:Class="TXABackupTool.NavButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">
    <Button x:Name="navBtn" Click="navBtn_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid Margin="0,0,20,4">
                    <!-- Active left accent bar -->
                    <Border x:Name="accentBar" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Background="{StaticResource PrimaryBrush}" CornerRadius="0,3,3,0"
                            Opacity="0" Margin="0,6,0,6"/>

                    <!-- Active glow overlay (separate border, no named Effect) -->
                    <Border x:Name="glowOverlay" Background="{StaticResource PrimaryBrush}"
                            CornerRadius="0,20,20,0" Margin="3,0,0,0" Opacity="0">
                        <Border.Effect>
                            <BlurEffect Radius="16"/>
                        </Border.Effect>
                    </Border>

                    <!-- Main nav item -->
                    <Border x:Name="border" Background="Transparent" Padding="28,14"
                            CornerRadius="0,20,20,0" Margin="3,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="icon"
                                       Text="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       FontSize="18" Margin="0,0,16,0" Opacity="0.5"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="text"
                                       Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                       Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <ControlTemplate.Triggers>
                    <!-- Active state -->
                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter TargetName="border" Property="Background" Value="#1867DF70"/>
                        <Setter TargetName="icon" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                        <Setter TargetName="icon" Property="Opacity" Value="1"/>
                        <Setter TargetName="text" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                        <Setter TargetName="text" Property="Opacity" Value="1"/>
                        <Setter TargetName="accentBar" Property="Opacity" Value="1"/>
                        <Setter TargetName="glowOverlay" Property="Opacity" Value="0.07"/>
                    </DataTrigger>

                    <!-- Hover state -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceBrightBrush}"/>
                        <Setter TargetName="text" Property="Opacity" Value="1"/>
                        <Setter TargetName="icon" Property="Opacity" Value="0.85"/>
                    </Trigger>

                    <!-- Press state -->
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>