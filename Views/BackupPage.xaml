<UserControl x:Class="TXABackupTool.Views.BackupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TXABackupTool.Views"
      xmlns:txa="clr-namespace:TXABackupTool.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineDisplay}" Margin="0,0,0,32"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Folder List -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="{Binding ChooseFolderText}" Style="{StaticResource SubHeadline}" Margin="0,0,0,12" Opacity="0.6"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding BackupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LiquidGlassCard}" Margin="0,0,12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0" IsEnabled="{Binding IsAvailable}">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,10,0" FontSize="16"/>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SourcePath}" Style="{StaticResource SubHeadline}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <ProgressBar Value="{Binding Progress}" Height="4" Margin="0,12,0,0" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{StaticResource SurfaceContainerHighestBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource SubHeadline}" FontSize="10" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <Button Grid.Row="2" Content="{Binding AddFolderText}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,12,12,0" Command="{Binding AddFolderCommand}" txa:TXATooltip.Text="${txa_tooltip_add}"/>
            </Grid>

            <!-- Log Panel -->
            <Border Grid.Column="1" Margin="16,0,0,0" Background="{StaticResource SurfaceContainerLowestBrush}" CornerRadius="24" Padding="24" BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LogsTitle}" Style="{StaticResource SubHeadline}" Margin="0,0,0,16" Opacity="0.6"/>
                    <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource OnSurfaceVariantBrush}" BorderThickness="0" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" TextChanged="LogBox_TextChanged"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Destination Path -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="20" Margin="0,32,0,32" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="📂" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DestText}" Style="{StaticResource SubHeadline}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding DestinationPath}" Background="{StaticResource SurfaceContainerLowestBrush}" Foreground="{StaticResource OnSurfaceBrush}" Padding="12" BorderThickness="0"/>
                <Button Grid.Column="2" Content="{Binding ChangeText}" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding BrowseDestinationCommand}" txa:TXATooltip.Text="${txa_tooltip_change_dest}"/>
            </Grid>
        </Border>

        <!-- Progress and Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,48,0">
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="{Binding OverallProgressLabel}" Style="{StaticResource SubHeadline}" FontSize="11" Opacity="0.6"/>
                    <TextBlock Text="{Binding ETAText}" Style="{StaticResource SubHeadline}" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding OverallProgress, StringFormat={}{0:F0}%}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>
                </Grid>
                <ProgressBar Value="{Binding OverallProgress}" Height="12" Foreground="{StaticResource PrimaryGradientBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{Binding StartText}" Style="{StaticResource PrimaryButton}" Margin="0,0,16,0" Command="{Binding StartCommand}" txa:TXATooltip.Text="${txa_tooltip_backup}"/>
                <Button Content="{Binding CancelText}" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="{Binding OpenTmText}" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0" Command="{Binding OpenDestCommand}"/>
                <Button Content="💾 LOG" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- Shortcut Selection Modal -->
        <txa:TXAModal Grid.RowSpan="4" IsOpen="{Binding IsShortcutModalOpen}" Title="{Binding ShortcutModalTitle}">
            <StackPanel Width="400">
                <TextBlock Text="{Binding ShortcutModalDesc}" 
                           Style="{StaticResource SubHeadline}" Margin="0,0,0,20" TextWrapping="Wrap" TextAlignment="Center"/>

                <Border Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="12" MaxHeight="300">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DetectedShortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="8,6" Cursor="Hand">
                                        <TextBlock Text="{Binding FileName}" FontSize="12" Opacity="0.9"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Button Content="{Binding BtnContinueBackup}" 
                        Style="{StaticResource PrimaryButton}" 
                        Margin="0,24,0,0" 
                        Command="{Binding ConfirmShortcutsCommand}" 
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </txa:TXAModal>

        <!-- Resume Backup Modal -->
        <txa:TXAModal Grid.RowSpan="4" IsOpen="{Binding IsResumeModalOpen}" Title="{Binding ResumeModalTitle}">
            <StackPanel Width="400">
                <TextBlock Text="{Binding ResumeModalDesc}" 
                           Style="{StaticResource SubHeadline}" Margin="0,0,0,24" TextWrapping="Wrap" TextAlignment="Center"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Content="{Binding BtnResume}" 
                            Style="{StaticResource PrimaryButton}" 
                            Margin="0,0,8,0" 
                            Command="{Binding ResumeDecisionCommand}" 
                            CommandParameter="True"/>

                    <Button Grid.Column="1" Content="{Binding BtnOverwrite}" 
                            Style="{StaticResource SecondaryButton}" 
                            Margin="8,0,0,0" 
                            Command="{Binding ResumeDecisionCommand}" 
                            CommandParameter="False"/>
                </Grid>
            </StackPanel>
        </txa:TXAModal>
        <!-- Summary Modal -->
        <txa:TXAModal Grid.RowSpan="4" IsOpen="{Binding IsSummaryModalOpen}" Title="{Binding SummaryTitle}">
            <StackPanel Width="400" Margin="0,10">
                <TextBlock Text="🎯" FontSize="64" Margin="0,0,0,24" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="{StaticResource PrimaryColor}"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding SummaryContent}" 
                           Foreground="{StaticResource OnSurfaceBrush}"
                           FontSize="18" TextAlignment="Center" 
                           LineHeight="32" Margin="0,0,0,40" TextWrapping="Wrap"/>

                <Button Content="{Binding BtnOk}" 
                        Style="{StaticResource PrimaryButton}" 
                        Width="220"
                        HorizontalAlignment="Center"
                        Command="{Binding CloseSummaryCommand}"/>
            </StackPanel>
        </txa:TXAModal>
    </Grid>
</UserControl>
