<UserControl x:Class="TXABackupTool.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:txa="clr-namespace:TXABackupTool.Helpers"
      xmlns:helpers="clr-namespace:TXABackupTool.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineDisplay}"/>
            <TextBlock Text="{Binding SubTitle}" Style="{StaticResource SubHeadline}" Margin="0,6,0,0" Opacity="0.55"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Language Section -->
                <Border Style="{StaticResource LiquidGlassCard}" Margin="0,0,0,16" Padding="28">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="&#x1F310;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LangSectionTitle}" Style="{StaticResource HeadlineDisplay}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="350"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="{Binding LangTitle}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource OnSurfaceBrush}"/>
                                <TextBlock Text="{Binding LangDesc}" Style="{StaticResource SubHeadline}" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                            <helpers:TXADropdown Grid.Column="1"
                                                  ItemsSource="{Binding AvailableLanguages}"
                                                  SelectedItem="{Binding SelectedLanguage}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                  txa:TXATooltip.Text="${txa_settings_lang_tip}">
                                <helpers:TXADropdown.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </helpers:TXADropdown.ItemTemplate>
                            </helpers:TXADropdown>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Behavior Section -->
                <Border Style="{StaticResource LiquidGlassCard}" Margin="0,0,0,16" Padding="28">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="&#x2699;&#xFE0F;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BehaviorSectionTitle}" Style="{StaticResource HeadlineDisplay}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Always on Top -->
                        <Border Background="{StaticResource SurfaceContainerLowestBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#x1F4CC;" FontSize="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding TopmostTitle}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TopmostDesc}" Style="{StaticResource SubHeadline}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding Topmost}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Style="{StaticResource TXAToggle}"
                                          txa:TXATooltip.Text="${txa_settings_topmost_tip}"/>
                            </Grid>
                        </Border>

                        <!-- Skip Shortcuts -->
                        <Border Background="{StaticResource SurfaceContainerLowestBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#x1F517;" FontSize="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding SkipShortcutsTitle}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SkipShortcutsDesc}" Style="{StaticResource SubHeadline}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding SkipShortcuts}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Style="{StaticResource TXAToggle}"
                                          txa:TXATooltip.Text="${txa_settings_skip_shortcuts_tip}"/>
                            </Grid>
                        </Border>

                        <!-- Auto Lang Detection -->
                        <Border Background="{StaticResource SurfaceContainerLowestBrush}" CornerRadius="14" Padding="20">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#x1F50D;" FontSize="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding AutoLangTitle}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AutoLangDesc}" Style="{StaticResource SubHeadline}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding AutoLangDetect}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Style="{StaticResource TXAToggle}"
                                          txa:TXATooltip.Text="${txa_settings_autolang_tip}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- About Section -->
                <Border Style="{StaticResource LiquidGlassCard}" Padding="28">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AboutSectionTitle}" Style="{StaticResource HeadlineDisplay}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="TXA BACKUP TOOL" FontWeight="ExtraBold" FontSize="22"
                                           Foreground="{StaticResource PrimaryBrush}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#67DF70" Opacity="0.45"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource SubHeadline}" FontSize="12" Margin="0,6,0,0" FontWeight="Bold"/>
                                <TextBlock Text="{Binding AuthorText}" Style="{StaticResource SubHeadline}" FontSize="12" Margin="0,2,0,0" Opacity="0.8"/>
                                <Button Content="{Binding ContactUrl}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,2,0,0" Command="{Binding OpenContactCommand}"/>
                                <TextBlock Text="{Binding CopyrightText}" Style="{StaticResource SubHeadline}" FontSize="11" Margin="0,12,0,0" Opacity="0.4"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="{Binding BtnOpenInstallDir}"
                                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                    Command="{Binding OpenInstallDirCommand}"
                                    txa:TXATooltip.Text="${txa_settings_open_dir_tip}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>