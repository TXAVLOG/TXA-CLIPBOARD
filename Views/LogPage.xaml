<UserControl x:Class="TXABackupTool.Views.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:txa="clr-namespace:TXABackupTool.Helpers"
      xmlns:helpers="clr-namespace:TXABackupTool.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + Action Buttons -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineDisplay}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding ClearCategoryText}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearCategoryCommand}" Margin="0,0,12,0"
                        txa:TXATooltip.Text="${txa_log_clear_cat_tip}"/>
                <Button Content="{Binding ClearLogsText}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearLogsCommand}"
                        txa:TXATooltip.Text="${txa_log_clear_tip}"/>
            </StackPanel>
        </DockPanel>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="20" Padding="16" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource SubHeadline}"
                           FontWeight="Bold" Opacity="0.6" VerticalAlignment="Center"
                           Margin="0,0,16,0" FontSize="11"/>

                <helpers:TXADropdown Grid.Column="1"
                                      ItemsSource="{Binding FilterOptions}"
                                      SelectedItem="{Binding FilterSelected}"
                                      HorizontalAlignment="Stretch"
                                      txa:TXATooltip.Text="${txa_log_filter_tip}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AutoLangStatus}" Foreground="{StaticResource PrimaryBrush}"
                               FontSize="11" FontWeight="Bold" Margin="0,0,10,0" Opacity="0.5"/>
                    <Border Background="{StaticResource PrimaryBrush}" Width="7" Height="7"
                            CornerRadius="4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.5" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log Content -->
        <Grid Grid.Row="2">

            <!-- Log List -->
            <Border Style="{StaticResource LiquidGlassCard}" Padding="0"
                    Visibility="{Binding HasLogs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SurfaceContainerHighBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="148"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Timestamp}" Opacity="0.45" FontSize="11" VerticalAlignment="Top" Margin="0,2,0,0"/>

                                    <!-- Type badge -->
                                    <Border Grid.Column="1" HorizontalAlignment="Left" Padding="6,2"
                                            MinWidth="56" Height="18" CornerRadius="4"
                                            Background="{Binding Color}" Opacity="0.85"
                                            VerticalAlignment="Top" Margin="0,1,10,0"
                                            txa:TXATooltip.Text="{Binding Type}">
                                        <TextBlock Text="{Binding Type}" Foreground="White"
                                                   FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Message + Copy button -->
                                    <DockPanel Grid.Column="2">
                                        <Button DockPanel.Dock="Right" Content="{Binding CopyIcon}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="6,2" FontSize="11" VerticalAlignment="Top"
                                                Command="{Binding CopyCommand}"
                                                txa:TXATooltip.Text="${txa_log_copy_tip}"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource OnSurfaceBrush}"
                                                   VerticalAlignment="Top" Margin="0,0,10,0"
                                                   FontSize="13" LineHeight="20"/>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Empty State -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasLogs, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Border Width="96" Height="96" Background="{StaticResource SurfaceContainerHighBrush}"
                        CornerRadius="48" Margin="0,0,0,20">
                    <TextBlock Text="&#x1F4C2;" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.35"/>
                </Border>
                <TextBlock Text="{Binding EmptyLogsText}" Style="{StaticResource SubHeadline}"
                           FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding NoLogsSubText}" Style="{StaticResource SubHeadline}"
                           FontSize="11" Opacity="0.3" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>